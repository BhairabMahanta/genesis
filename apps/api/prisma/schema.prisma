  updated_by          String           @db.VarChar(255)
  version             BigInt?
  cluster_number      Int
  color               String?          @db.VarChar(20)
  label               String?          @db.VarChar(500)
  mention_count       Int?
  representative_text String?          @db.VarChar(1000)
  workspace_id        String           @db.Uuid
  workspaces          Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cluster_workspace")
  coref_mentions      coref_mentions[]

  @@unique([workspace_id, cluster_number], map: "idx_cluster_workspace_number")
  @@index([workspace_id], map: "idx_cluster_workspace")
