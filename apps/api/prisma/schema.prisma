generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                      @id @default(uuid()) @db.Uuid
  createdAt                 DateTime                    @map("created_at") @db.Timestamptz(6)
  createdBy                 String                      @map("created_by") @db.VarChar(255)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                 String                      @map("updated_by") @db.VarChar(255)
  version                   BigInt?
  accountLocked             Boolean                     @map("account_locked")
  authProvider              String                      @map("auth_provider") @db.VarChar(20)
  email                     String                      @unique(map: "uk6dotkott2kjsp8vw4d0m25fb7") @db.VarChar(255)
  emailVerified             Boolean                     @map("email_verified")
  enabled                   Boolean
  firstName                 String                      @map("first_name") @db.VarChar(100)
  lastLoginAt               DateTime?                   @map("last_login_at") @db.Timestamptz(6)
  lastName                  String                      @map("last_name") @db.VarChar(100)
  organizationName          String?                     @map("organization_name") @db.VarChar(255)
  password                  String                      @db.VarChar(255)
  providerId                String?                     @map("provider_id") @db.VarChar(255)
  username                  String                      @unique(map: "ukr43af9ap4edm43mmtq01oddj6") @db.VarChar(50)
  dismissed_recommendations dismissed_recommendations[]
  editor_sessions           editor_sessions[]
  notifications             notifications[]
  refreshTokens             RefreshToken[]
  memberships               WorkspaceMember[]
  workspaces                Workspace[]                 @relation("WorkspaceOwner")

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @map("created_at") @db.Timestamptz(6)
  created_by String   @db.VarChar(255)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updated_by String   @db.VarChar(255)
  version    BigInt?
  expiryDate DateTime @map("expiry_date") @db.Timestamptz(6)
  revoked    Boolean
  token      String   @unique(map: "ukghpmfn23vmxfu3spu3lfg4r2d") @db.VarChar(500)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk1lih5y2npsf8u5o3vhdb9y0os")

  @@index([token], map: "idx_refresh_tokens_token")
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model Workspace {
  id                        String                      @id @default(uuid()) @db.Uuid
  createdAt                 DateTime                    @map("created_at") @db.Timestamptz(6)
  createdBy                 String                      @map("created_by") @db.VarChar(255)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                 String                      @map("updated_by") @db.VarChar(255)
  version                   BigInt?
  annotationType            String                      @map("annotation_type") @db.VarChar(20)
  description               String?
  name                      String                      @db.VarChar(100)
  status                    String                      @db.VarChar(20)
  ownerId                   String                      @map("owner_id") @db.Uuid
  annotation_log            annotation_log[]
  coref_clusters            coref_clusters[]
  coref_mentions            coref_mentions[]
  dismissed_recommendations dismissed_recommendations[]
  documents                 Document[]
  editor_sessions           editor_sessions[]
  notifications             notifications[]
  members                   WorkspaceMember[]
  owner                     User                        @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk58ks96jjlsbhsh21cen7hr59h")
  wsd_annotation            wsd_annotation[]
  wsd_sense                 wsd_sense[]

  @@index([ownerId], map: "idx_workspaces_owner_id")
  @@index([status], map: "idx_workspaces_status")
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  created_by  String    @db.VarChar(255)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updated_by  String    @db.VarChar(255)
  version     BigInt?
  role        String    @db.VarChar(20)
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6vtnpc3eexk504u61uepn40p1")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkw9hq87n3rvq2c4j47qo78i5r")

  @@unique([workspaceId, userId], map: "uk_workspace_members_workspace_user")
  @@index([role], map: "idx_workspace_members_role")
  @@index([userId], map: "idx_workspace_members_user_id")
  @@index([workspaceId], map: "idx_workspace_members_workspace_id")
  @@map("workspace_members")
}

model StoredFile {
  id               String    @id @default(uuid()) @db.Uuid
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  created_by       String    @db.VarChar(255)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updated_by       String    @db.VarChar(255)
  version          BigInt?
  contentType      String?   @map("content_type") @db.VarChar(255)
  fileSize         BigInt?   @map("file_size")
  folder           String?   @db.VarChar(255)
  format           String?   @db.VarChar(255)
  originalFilename String    @map("original_filename") @db.VarChar(255)
  publicId         String    @unique(map: "ukj6q2r19h9ywnu08womnhs6f4y") @map("public_id") @db.VarChar(255)
  resourceType     String?   @map("resource_type") @db.VarChar(255)
  url              String    @db.VarChar(1024)
  document         Document?

  @@map("stored_files")
}

model Document {
  id               String            @id @default(uuid()) @db.Uuid
  createdAt        DateTime          @map("created_at") @db.Timestamptz(6)
  createdBy        String            @map("created_by") @db.VarChar(255)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String            @map("updated_by") @db.VarChar(255)
  version          BigInt?
  fileSize         BigInt?           @map("file_size")
  name             String            @db.VarChar(255)
  orderIndex       Int               @map("order_index")
  processingError  String?           @map("processing_error") @db.VarChar(1000)
  processingStatus String?           @map("processing_status") @db.VarChar(20)
  progress         Float?
  status           String            @db.VarChar(20)
  tokenEndIndex    Int?              @map("token_end_index")
  tokenStartIndex  Int?              @map("token_start_index")
  storedFileId     String?           @unique(map: "uk3rwx6vb7lrr50dd93wemwfqm7") @map("stored_file_id") @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  coref_mentions   coref_mentions[]
  storedFile       StoredFile?       @relation(fields: [storedFileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk8qahhj9hi2hsa6vnsf5x4mke")
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkp8lrsv9kvf60o04juy6uj3c1j")
  ner_annotations  ner_annotations[]
  pos_annotations  pos_annotations[]
  sentences        Sentence[]
  tokens           Token[]
  wsd_annotation   wsd_annotation[]

  @@index([workspaceId, orderIndex], map: "idx_documents_order_index")
  @@index([status], map: "idx_documents_status")
  @@map("documents")
}

model Sentence {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  created_by    String   @db.VarChar(255)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updated_by    String   @db.VarChar(255)
  version       BigInt?
  documentId    String   @map("document_id") @db.Uuid
  endOffset     Int      @map("end_offset")
  sentenceIndex Int      @map("sentence_index")
  startOffset   Int      @map("start_offset")
  text          String?
  tokenCount    Int?     @map("token_count")
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sentence_document")

  @@index([documentId], map: "idx_sentence_document")
  @@index([documentId, sentenceIndex], map: "idx_sentence_document_index")
  @@map("sentences")
}

model Token {
  id              String            @id @default(uuid()) @db.Uuid
  createdAt       DateTime          @map("created_at") @db.Timestamptz(6)
  created_by      String            @db.VarChar(255)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updated_by      String            @db.VarChar(255)
  version         BigInt?
  documentId      String            @map("document_id") @db.Uuid
  endOffset       Int               @map("end_offset")
  form            String            @db.VarChar(500)
  globalIndex     Int               @map("global_index")
  lemma           String?           @db.VarChar(500)
  nerTag          String?           @map("ner_tag") @db.VarChar(100)
  pos             String?           @db.VarChar(20)
  sentenceIndex   Int               @map("sentence_index")
  startOffset     Int               @map("start_offset")
  tokenIndex      Int               @map("token_index")
  pos_annotations pos_annotations[]
  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_token_document")
  wsd_annotation  wsd_annotation[]

  @@index([documentId], map: "idx_token_document")
  @@index([documentId, sentenceIndex], map: "idx_token_document_sentence")
  @@index([documentId, globalIndex], map: "idx_token_global")
  @@map("tokens")
}

