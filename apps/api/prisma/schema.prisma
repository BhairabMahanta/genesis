model coref_mentions {
  id                 String          @id @db.Uuid
  created_at         DateTime        @db.Timestamptz(6)
  created_by         String          @db.VarChar(255)
  updated_at         DateTime        @db.Timestamptz(6)
  updated_by         String          @db.VarChar(255)
  version            BigInt?
  cluster_id         String?         @db.Uuid
  document_id        String          @db.Uuid
  end_token_index    Int
  global_end_index   Int?
  global_start_index Int?
  mention_type       String?         @db.VarChar(50)
  sentence_index     Int
  start_token_index  Int
  text               String?         @db.VarChar(2000)
  workspace_id       String          @db.Uuid
  coref_clusters     coref_clusters? @relation(fields: [cluster_id], references: [id], onUpdate: NoAction, map: "fk_mention_cluster")
  documents          Document        @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mention_document")
  workspaces         Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mention_workspace")

  @@index([cluster_id], map: "idx_mention_cluster")
  @@index([document_id, sentence_index], map: "idx_mention_doc_sentence")
  @@index([document_id], map: "idx_mention_document")
  @@index([workspace_id], map: "idx_mention_workspace")
}

