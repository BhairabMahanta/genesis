{
  "name": "genesis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:web": "node scripts/dev.mjs web",
    "dev:all": "node scripts/dev.mjs",
    "build": "pnpm --filter \"@genesis/*\" build",
    "lint": "pnpm --filter \"@genesis/*\" lint",
    "typecheck": "pnpm --filter \"@genesis/*\" typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
