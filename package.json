{
  "name": "genesis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @genesis/web dev",
    "dev:api": "pnpm --filter @genesis/api dev",
    "dev:all": "pnpm --filter \"@genesis/*\" dev",
    "build": "pnpm --filter \"@genesis/*\" build",
    "lint": "pnpm --filter \"@genesis/*\" lint",
    "typecheck": "pnpm --filter \"@genesis/*\" typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
