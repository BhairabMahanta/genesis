# Copy to `.env` (git-ignored) for local development overrides.
# `pnpm dev` reads `.env.local` first, then `.env`.
# Existing shell environment variables take precedence over both files.

# Fixed local ports. 8080 is commonly occupied on developer machines.
API_PORT=8099
WEB_PORT=3000

# PostgreSQL (Flyway-owned schema; Prisma is only a query client).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis

# Development-only signing secret (must be at least 32 characters).
JWT_SECRET=dev-only-insecure-secret-min-32-chars-long!!

# Browser-facing and Next-server-facing API URLs. Defaults follow API_PORT.
# NEXT_PUBLIC_API_URL=http://localhost:8099
# INTERNAL_API_URL=http://localhost:8099

# Local uploads. Relative paths resolve from apps/api.
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=data/uploads

# Set to false to silence API request logs.
API_REQUEST_LOGS=true

# --- Dev launcher (`pnpm dev`) ------------------------------------------------------------
# auto (default): start Docker Desktop + the compose database when DATABASE_URL points at
# localhost:5432, apply migrations, and seed the demo account.
# true / false force or skip the Docker bootstrap (use false with your own PostgreSQL).
# DEV_DOCKER=auto
# Set to false to skip `pnpm seed:demo` on startup.
# DEV_SEED_DEMO=true

# --- Docker stack (docker-compose.yml: PostgreSQL + migrations + the API) ---------------
# `docker compose up -d --build` reads these from `.env`. Generate real values, e.g.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
# POSTGRES_PASSWORD must match the password inside DATABASE_URL above (both default to "postgres",
# which is safe only because the compose database listens on 127.0.0.1). Use a real one anywhere else.
POSTGRES_PASSWORD=postgres
# JWT_SECRET (above) must be 32+ characters; the compose API requires it to be set.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
